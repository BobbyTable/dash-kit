{
  "name": "@bobbytable/dash-kit",
  "version": "0.3.0",
  "description": "Dracula / Alucard dashboard kit: colour tokens, cards, charts, tables, tabs, pop-ups, icons \u2014 CSS plus small dependency-free JS (line chart, bar tooltips, formatting, copy).",
  "license": "MIT",
  "type": "module",
  "files": [
    "example.html",
    "index.css",
    "css/",
    "js/",
    "dist/",
    "fonts/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.css",
    "./index.css": "./index.css",
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*",
    "./icons": "./js/icons.js",
    "./chart": "./js/chart.js",
    "./bars": "./js/bars.js",
    "./markup": "./js/markup.js",
    "./format": "./js/format.js",
    "./tooltip": "./js/tooltip.js",
    "./copy": "./js/copy.js",
    "./js/*": "./js/*",
    "./global": "./dist/dash-kit.global.js"
  },
  "style": "index.css",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BobbyTable/dash-kit.git"
  },
  "keywords": [
    "css",
    "dracula",
    "dashboard",
    "design-system"
  ],
  "peerDependencies": {
    "lucide": ">=0.400.0"
  },
  "peerDependenciesMeta": {
    "lucide": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.cjs",
    "prepublishOnly": "node build.cjs"
  }
}
